@page "/teams/{Id:int}"
@inject ITeamService TeamService
@using HDA.Domain.Entities
@using HDA.Domain.Enums
@using HDA.Infrastructure.Services
@using MudBlazor

<PageTitle>@(_team?.Name ?? "Team") — HDA.gg</PageTitle>

@if (_loading)
{
    <MudProgressLinear Indeterminate="true" Color="Color.Primary" />
}
else if (_team == null)
{
    <MudAlert Severity="Severity.Error">Team not found.</MudAlert>
}
else
{
    <!-- Team Header -->
    <MudPaper Elevation="0" Style="background:linear-gradient(135deg,#16213E,#0D0D1A); border:1px solid #1E1E3A; border-radius:12px; padding:32px; margin-bottom:24px;">
        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="4">
            <MudAvatar Style="width:90px;height:90px;background:#0D0D1A;">
                <MudImage Src="@(_team.LogoUrl ?? "/images/default-team.png")" Width="72" Height="72" />
            </MudAvatar>
            <div>
                <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                    <MudText Typo="Typo.h3" Style="color:#EAEAEA; font-weight:900;">@_team.Name</MudText>
                    <MudChip T="string" Color="Color.Primary" Size="Size.Small">@_team.Tag</MudChip>
                    <MudChip T="string" Style="background:#FFD700;color:#000;" Size="Size.Small">
                        #@_team.WorldRank
                    </MudChip>
                </MudStack>
                <MudStack Row="true" Spacing="3" Class="mt-1">
                    <MudText Typo="Typo.body2" Style="color:#8A8AAA;">📍 @_team.Region</MudText>
                    @if (_team.Country != null)
                    {
                        <MudText Typo="Typo.body2" Style="color:#8A8AAA;">🏳 @_team.Country</MudText>
                    }
                    <MudText Typo="Typo.body2" Style="color:#8A8AAA;">Founded @_team.Founded.Year</MudText>
                    <MudChip T="string" Color="Color.Error" Size="Size.Small">@_team.RatingPoints pts</MudChip>
                </MudStack>
            </div>
        </MudStack>
    </MudPaper>

    <MudGrid Spacing="3">
        <!-- Roster -->
        <MudItem xs="12" md="5">
            <MudText Typo="Typo.h6" Class="mb-3" Style="color:#EAEAEA;">Current Roster</MudText>
            @foreach (var player in _team.Players.OrderBy(p => (int)p.Role))
            {
                <MudPaper Elevation="0" Style="background:#16213E; border:1px solid #1E1E3A; border-radius:8px; padding:12px; margin-bottom:8px; cursor:pointer;"
                          onclick="@(() => Nav.NavigateTo($"/players/{player.Id}"))">
                    <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                        <MudAvatar Size="Size.Medium" Style="background:#0D0D1A;">
                            @if (player.AvatarUrl != null)
                            {
                                <MudImage Src="@player.AvatarUrl" Width="40" Height="40" />
                            }
                            else
                            {
                                <MudIcon Icon="@Icons.Material.Filled.Person" />
                            }
                        </MudAvatar>
                        <div style="flex:1;">
                            <MudText Typo="Typo.body1" Style="color:#EAEAEA; font-weight:600;">@player.Nickname</MudText>
                            <MudText Typo="Typo.caption" Style="color:#8A8AAA;">@player.RealName · @player.Country</MudText>
                        </div>
                        <MudChip T="string" Size="Size.Small" Color="Color.Primary" Style="font-size:0.65rem;">
                            @player.Role
                        </MudChip>
                    </MudStack>
                </MudPaper>
            }
        </MudItem>

        <!-- Recent Matches + Hero Stats -->
        <MudItem xs="12" md="7">
            <MudText Typo="Typo.h6" Class="mb-3" Style="color:#EAEAEA;">Recent Matches</MudText>
            @foreach (var m in _recentMatches)
            {
                <MatchCard Match="m" />
            }

            @if (_team.HeroStats.Any())
            {
                <MudText Typo="Typo.h6" Class="mt-4 mb-3" Style="color:#EAEAEA;">Most Picked Heroes</MudText>
                <MudTable Items="_team.HeroStats.OrderByDescending(h => h.Picks).Take(10)"
                          Dense="true" Style="background:#16213E; border:1px solid #1E1E3A; border-radius:8px;">
                    <HeaderContent>
                        <MudTh Style="color:#8A8AAA;">Hero</MudTh>
                        <MudTh Style="color:#8A8AAA;">Picks</MudTh>
                        <MudTh Style="color:#8A8AAA;">Bans</MudTh>
                        <MudTh Style="color:#8A8AAA;">Win Rate</MudTh>
                    </HeaderContent>
                    <RowTemplate>
                        <MudTd><MudText Style="color:#EAEAEA;">@context.Hero?.LocalizedName</MudText></MudTd>
                        <MudTd><MudText Style="color:#FFC107;">@context.Picks</MudText></MudTd>
                        <MudTd><MudText Style="color:#EF5350;">@context.Bans</MudText></MudTd>
                        <MudTd>
                            @{
                                var wr = context.Picks > 0 ? (double)context.Wins / context.Picks * 100 : 0;
                            }
                            <MudText Style="@(wr >= 50 ? "color:#4CAF50;" : "color:#EF5350;")">
                                @wr.ToString("F1")%
                            </MudText>
                        </MudTd>
                    </RowTemplate>
                </MudTable>
            }
        </MudItem>
    </MudGrid>
}

@code {
    [Parameter] public int Id { get; set; }
    [Inject] NavigationManager Nav { get; set; } = null!;
    private Team? _team;
    private List<Match> _recentMatches = [];
    private bool _loading = true;

    protected override async Task OnInitializedAsync()
    {
        _team = await TeamService.GetDetailAsync(Id);
        _recentMatches = await TeamService.GetRecentMatchesAsync(Id, 5);
        _loading = false;
    }
}
